# ---------------------------------------------------------------------------
# aeroQ configuration
# Copy to .env and fill in. Every value here has a working default except the
# provider API keys — with no keys set, the app runs entirely on MockProvider.
# ---------------------------------------------------------------------------

# --- Providers -------------------------------------------------------------
# Comma-separated, in priority order. The router tries them left to right,
# skipping any that are out of budget or unhealthy.
# Providers whose API key is absent are dropped from the order automatically.
PROVIDER_ORDER=aerodatabox,airlabs,mock

# AeroDataBox is distributed via RapidAPI.
# VERIFY BEFORE USE (BUILD_PLAN.md §12.1): free-tier monthly quota, whether the
# airport-departures (FIDS) endpoint is included in the free plan, and — most
# importantly — whether exceeding the tier hard-fails or auto-bills.
AERODATABOX_API_KEY=
AERODATABOX_API_HOST=aerodatabox.p.rapidapi.com

# AirLabs: direct signup, no RapidAPI.
AIRLABS_API_KEY=

# --- Budget ----------------------------------------------------------------
# Per-provider monthly hard caps, enforced locally and independently of the
# provider. Set these BELOW the actual free tier so we stop before they do.
AERODATABOX_MONTHLY_CAP=250
AIRLABS_MONTHLY_CAP=900

# Self-balancing daily allowance bounds (BUILD_PLAN.md §8):
#   daily_allowance = clamp(remaining_month / days_left, MIN, MAX)
DAILY_ALLOWANCE_MIN=10
DAILY_ALLOWANCE_MAX=60

# --- Cache -----------------------------------------------------------------
CACHE_TTL_HOURS=4
DEPARTURE_BLOCK_HOURS=12

# --- Prediction tunables ---------------------------------------------------
SEATS_PER_FLIGHT=150
ORIGIN_PAX_FACTOR=0.75
RUSH_WINDOW_HOURS=2
LANES_PER_TERMINAL=5
PAX_PER_LANE_PER_HOUR=150
LIGHT_MAX_RATIO=0.6
MODERATE_MAX_RATIO=1.0
BASE_WAIT_MIN=5
SATURATED_WAIT_MIN=25
MAX_WAIT_MIN=120
GATE_BUFFER_MIN=45

# --- History corpus --------------------------------------------------------
MIN_SAMPLES_FOR_BASELINE=3

# --- Runtime ---------------------------------------------------------------
DB_PATH=./data/aeroq.db
LOG_LEVEL=INFO
# Comma-separated origins for dev. Production is single-origin, so leave empty.
CORS_ORIGINS=http://localhost:5173
